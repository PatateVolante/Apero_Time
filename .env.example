# --- Apéro Time : copier en .env puis `docker compose up -d` ---

# Version de l'image (latest, 2.0.0, 2.0…)
APERO_TAG=latest
# Port publié sur l'hôte (ignoré en mode Traefik)
APERO_PORT=5001

# Heure de début / fin de l'apéro (24 = minuit)
APERO_HOUR=18
APERO_END_HOUR=24

# Optionnel : GIF contextualisés (https://developers.giphy.com/). Vide = emoji animé.
GIPHY_API_KEY=
GIPHY_RATING=pg

# Optionnel : origines autorisées à appeler /api/* depuis un autre site (séparées par des virgules)
CORS_ORIGINS=

# --- Mode Traefik : décommenter ces lignes ---
# COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
# APERO_HOST=apero.mars.patatevolante.fr
# TRAEFIK_NETWORK=frontend
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=patatevolante
